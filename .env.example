# Visão de Produto — variáveis de ambiente (seção 15.5 do spec.md)
# Copie este arquivo para .env e preencha os valores. O .env NUNCA vai para o git.

# --- Site (apps/web) -------------------------------------------------------
# Pública. Painel do Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Pública. Painel do Supabase → Project Settings → API → anon / public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETA. Painel do Supabase → Project Settings → API → service_role key.
# Só pode existir em Edge Functions e rotas de servidor. Nunca no bundle do cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- App instrumentado (quem usa o SDK) ------------------------------------
# Pública por natureza (regra 5.1.3): a chave de ingestão só escreve, e só no
# próprio projeto. Gerada na tela de Configurações do projeto ou por `npx visao init`.
VISAO_API_KEY=

# Pública. URL base da ingestão, ex.: https://<ref>.supabase.co
VISAO_HOST=

# --- Cobrança (épico F10) --------------------------------------------------
# SECRETA. Painel da Stripe → Developers → API keys. Use a de TESTE (sk_test_)
# em dev; a de produção só no ambiente de produção.
STRIPE_SECRET_KEY=

# SECRETA. Sai do endpoint de webhook criado no painel da Stripe. Localmente,
# qualquer valor serve — desde que seja o mesmo usado para assinar o evento.
STRIPE_WEBHOOK_SECRET=

# O preço recorrente de R$ 50/mês, do catálogo da Stripe (price_...).
STRIPE_PRICE_ID=
