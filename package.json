{
  "name": "visao-de-produto",
  "version": "0.1.0",
  "private": true,
  "description": "Vis\u00e3o de Produto \u2014 plataforma de product analytics MCP-native",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @dablab/visao-web dev",
    "db:schema": "supabase db dump --linked -f schema.sql"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "supabase": "2.114.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vercel": "^59.1.3",
    "vitest": "3.2.4"
  }
}
